  "$provenance": {
    "source": "https://shopify.dev/docs/api/webhooks/latest (topic ORDERS_FULFILLED)",
    "supporting_sources": [
      "https://shopify.dev/docs/api/admin-rest/latest/resources/order (the abbreviated fulfillment element shape)"
