PROXYSHOP_WORKER=1

# The four least-privilege roles' password has ONE source of truth (T-112). It is seeded by
# db/init/00-roles.sql on a fresh volume and by db/migrations/0001 in every worker database,
# forwarded into the postgres container by docker-compose.yml, and read back on the connect
# side by proxyshop_support.postgres — all from this one variable. Leave it UNSET to get the
# documented dev default, whose single copy lives in 00-roles.sql's coalesce(); setting it
# here (or in the shell before `make deps-up`) changes the seed and the connect side
# together. It must be set BEFORE the pgdata volume is created: the initdb hook runs once.
# PROXYSHOP_ROLE_PASSWORD=

# Postgres (D38). The DATABASE component below is ADVISORY: proxyshop_support.postgres
# rewrites it to proxyshop_w$PROXYSHOP_WORKER on every connection, so a .env copied between
# worktrees can never put two workers in one database. Host and port are taken from these
# values; all five are optional (the compose defaults are identical). NONE of the five
# carries a password on purpose (T-112) — a literal in a file every worktree copies is a
# copy that stops agreeing with the cluster the moment the credential changes. The four
# role passwords come from PROXYSHOP_ROLE_PASSWORD above; admin's comes from
# proxyshop_support.postgres.ROLES, which a test pins to docker-compose.yml's
# POSTGRES_PASSWORD. Add a password back here only to override one role, and know that
# PROXYSHOP_ROLE_PASSWORD outranks it.
PROXYSHOP_PG_DSN_ADMIN=postgresql://proxyshop@localhost:5432/proxyshop_w1
PROXYSHOP_PG_DSN_EXCHANGE=postgresql://exchange@localhost:5432/proxyshop_w1
PROXYSHOP_PG_DSN_TRUST_RW=postgresql://trust_rw@localhost:5432/proxyshop_w1
PROXYSHOP_PG_DSN_VAULT=postgresql://buyer_vault@localhost:5432/proxyshop_w1
PROXYSHOP_PG_DSN_APP=postgresql://app@localhost:5432/proxyshop_w1
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=proxyshop_dev_pw
# No database component on purpose (D39): the logical DB index is the worker index and
# proxyshop_support.redis_client sets it authoritatively. A `/1` here used to be
# silently authoritative instead, landing every worker on DB 1 to FLUSHDB each other.
REDIS_URL=redis://localhost:6379
SHOPIFY_STUB_URL=http://localhost:8787
EMBEDDING_PROVIDER=hash
LLM_PROVIDER=double
BUYER_MODEL=claude-sonnet-4-5
STORE_AGENT_MODEL=claude-sonnet-4-5
# The hosted store agent advocates for exactly ONE store and the `BidRequest` on the wire does
# not name one, so the store context is deployment configuration. Both are empty by default and
# an empty STORE_AGENT_CONTEXT is a decision, not an error: the agent answers every solicitation
# `204 store_context_unconfigured` and `collect_bids` represents it at list price (R10). Point
# the first at a JSON store context INSIDE the container (see packages/store-agent/compose.yaml
# for the volume that puts it there); set the second when that file states no domain of its own
# — without a domain the agent emits no `checkout_url` and the exchange's C10 check drops the
# bid from every shortlist.
STORE_AGENT_CONTEXT=
STORE_AGENT_STORE_DOMAIN=
INTERVIEW_MODEL=claude-opus-4-1
EXTRACT_MODEL=claude-haiku-4-5
CHECKOUT_MODE=redirect

# The exchange's composition root (apps/exchange/src/composition.py). Point ONE of these at a
# deployment document and `uvicorn exchange.main:app` binds the collaborators it names — the
# seller registry (eligibility + registered checkout domains + where each store agent answers),
# the trust service's blacklist projection, and the checkout mode. Left unset — which is the
# default and is what a fresh checkout gets — the exchange keeps every fail-closed default:
# every store is denied `unavailable`, nothing is ranked and nothing can be accepted. That is
# the correct posture for an exchange nobody has configured, and it is why these are commented
# out rather than given a value.
#
#   {"sellers": [{"store_id": "s1", "eligibility": "eligible",
#                 "registered_domain": "s1.example.com",
#                 "bid_endpoint": "http://store-agent-s1:8080/v1/bid-requests"}],
#    "trust_snapshot": {"s1": {"store_id": "s1", "blacklisted": false, "score": 0.8}},
#    "checkout_mode": "redirect"}
#
# EXCHANGE_DEPLOYMENT is a path (inside the container, when running under compose);
# EXCHANGE_DEPLOYMENT_JSON is the same document inline and needs no mount. The path wins if
# both are set. A named-but-unreadable path, or a document with an unrecognised eligibility
# word, a registered domain carrying a scheme, a non-boolean `blacklisted` or an unregistered
# checkout mode, is a 503 naming the row — never a silently empty shortlist.
# EXCHANGE_DEPLOYMENT=
# EXCHANGE_DEPLOYMENT_JSON=
SEED_CATEGORY=coffee
RANKING_WEIGHTS=w_m=0.35,w_e=0.20,w_t=0.20,w_v=0.15,w_d=0.10

# Published host ports (D9: every one verified free on this host at scaffold time;
# D40: all env-overridable, and no test may hard-code a port).
PG_PORT=5432
REDIS_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
