{
  "openapi": "3.1.0",
  "info": {
    "title": "ProxyShop merchant service",
    "version": "1.0.0",
    "description": "Code minting, Shopify webhooks, the pixel collector, and envelope administration. The envelope routes are SEALED state (C3/S7): the exchange has no grant to read them and `.importlinter` forbids the import."
  },
  "x-domain": "merchant",
  "paths": {
    "/install": {
      "get": {
        "operationId": "startInstall",
        "summary": "Begin an install: redirect the merchant to Shopify's authorize screen.",
        "description": "Served and declared nowhere until T-317. It is a browser redirect rather than a cross-domain service call, which is exactly why it was left out — and exactly why it was never reviewed. It is unauthenticated, it takes a caller-supplied `shop`, and it issues a signed install state; a surface with those three properties belongs in the contract.",
        "parameters": [
          {
            "name": "shop",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to Shopify's OAuth authorize screen, carrying the signed install state.",
            "headers": {
              "location": {
                "schema": {
                  "type": "string"
                },
                "description": "The authorize URL."
              }
            }
          },
          "400": {
            "description": "`shop` is not a shop domain this app will talk to.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "A stable machine-readable refusal code."
                    },
                    "detail": {
                      "type": "string"
                    },
                    "missing": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "expected": {
                      "type": "string"
                    },
                    "got": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "invalid-shop",
                  "detail": "not a myshopify.com domain"
                }
              }
            }
          },
          "422": {
            "description": "`shop` was not supplied.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                },
                "example": {
                  "detail": [
                    {
                      "type": "missing",
                      "loc": [
                        "query",
                        "shop"
                      ],
                      "msg": "Field required"
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "No Shopify API key/secret is configured, so no state can be issued or verified.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "A stable machine-readable refusal code."
                    },
                    "detail": {
                      "type": "string"
                    },
                    "missing": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "expected": {
                      "type": "string"
                    },
                    "got": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "app-not-configured",
                  "missing": [
                    "SHOPIFY_API_KEY/SECRET"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/install/callback": {
      "get": {
        "operationId": "finishInstall",
        "summary": "Verify Shopify's redirect, exchange the code, store the offline token, install.",
        "description": "The other half of the OAuth pair, and the more sensitive one: it consumes the install state, spends an authorization code and stores an offline token. A forged, tampered and expired state all answer the same 400 on purpose — telling them apart is a signal handed to whoever is guessing.",
        "responses": {
          "200": {
            "description": "The install that was completed: scopes granted, pixel installed, webhooks registered.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "shop",
                    "scopes"
                  ],
                  "properties": {
                    "shop": {
                      "type": "string"
                    },
                    "scopes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "web_pixel_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "webhooks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "topic": {
                            "type": "string"
                          },
                          "uri": {
                            "type": "string"
                          },
                          "already_registered": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "offline_token_stored": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "shop": "demo-store.myshopify.com",
                  "scopes": [
                    "read_products",
                    "write_discounts"
                  ],
                  "web_pixel_id": "gid://shopify/WebPixel/1",
                  "webhooks": [
                    {
                      "topic": "orders/paid",
                      "uri": "https://app.example.com/webhooks/shopify/orders/paid",
                      "already_registered": false
                    }
                  ],
                  "offline_token_stored": true
                }
              }
            }
          },
          "400": {
            "description": "The state is unknown, or the shop it was issued for is not the shop that came back.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "A stable machine-readable refusal code."
                    },
                    "detail": {
                      "type": "string"
                    },
                    "missing": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "expected": {
                      "type": "string"
                    },
                    "got": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "unknown-state"
                }
              }
            }
          },
          "401": {
            "description": "The callback's own HMAC did not verify.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "A stable machine-readable refusal code."
                    },
                    "detail": {
                      "type": "string"
                    },
                    "missing": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "expected": {
                      "type": "string"
                    },
                    "got": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "callback-rejected",
                  "detail": "hmac mismatch"
                }
              }
            }
          },
          "502": {
            "description": "Shopify was unreachable or refused the exchange. Not this app being broken.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "A stable machine-readable refusal code."
                    },
                    "detail": {
                      "type": "string"
                    },
                    "missing": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "expected": {
                      "type": "string"
                    },
                    "got": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "token-exchange-failed",
                  "detail": "connect timeout"
                }
              }
            }
          },
          "503": {
            "description": "No Shopify API key/secret is configured.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "A stable machine-readable refusal code."
                    },
                    "detail": {
                      "type": "string"
                    },
                    "missing": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "expected": {
                      "type": "string"
                    },
                    "got": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "app-not-configured",
                  "missing": [
                    "SHOPIFY_API_KEY/SECRET"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/install/shops": {
      "get": {
        "operationId": "listInstalledShops",
        "summary": "Every shop this process holds an offline token for. Administrative; bearer-guarded.",
        "description": "An administrative JSON endpoint, not a browser redirect — the reason T-317 refused the 'it is only the OAuth pair' exemption. It enumerates every installed merchant, and it refuses every caller until MERCHANT_ADMIN_TOKEN is configured.",
        "responses": {
          "200": {
            "description": "The shops with a stored offline token.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "shops"
                  ],
                  "properties": {
                    "shops": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "example": {
                  "shops": [
                    "demo-store.myshopify.com"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No bearer token, or one that does not match.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "A stable machine-readable refusal code."
                    },
                    "detail": {
                      "type": "string"
                    },
                    "missing": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "expected": {
                      "type": "string"
                    },
                    "got": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "unauthorized"
                }
              }
            }
          },
          "503": {
            "description": "No administrative token is configured, so the route refuses everyone.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "A stable machine-readable refusal code."
                    },
                    "detail": {
                      "type": "string"
                    },
                    "missing": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "expected": {
                      "type": "string"
                    },
                    "got": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "admin-api-not-configured",
                  "missing": [
                    "MERCHANT_ADMIN_TOKEN"
                  ],
                  "detail": "administrative routes refuse every caller until a token is configured"
                }
              }
            }
          }
        }
      }
    },
    "/codes": {
      "post": {
        "operationId": "createDiscountCode",
        "summary": "Mint a single-use discount code and cart permalink for a winning offer.",
        "description": "Creates a discountCodeBasicCreate with usageLimit 1 and an expiry no further out than 48h, and validates combinesWith before returning.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["store_id", "offer"],
                "properties": {
                  "store_id": { "type": "string" },
                  "offer": { "$ref": "https://proxyshop.dev/schemas/protocol.schema.json#/$defs/Offer" }
                }
              },
              "example": {
                "store_id": "store-1",
                "offer": {
                  "product_ref": "prod-1",
                  "variant_ref": "44352913",
                  "unit_price": 49.0,
                  "currency": "USD",
                  "discount": {
                    "type": "percentage",
                    "value": 10.0,
                    "provenance": {
                      "source": "envelope_rule",
                      "ref": "envelope:store-1:v3#max_discount_pct",
                      "observed_at": "2026-01-01T00:00:00Z",
                      "authority_rank": 1
                    }
                  },
                  "commitments": [],
                  "total_price": 44.1,
                  "expires_at": "2026-01-03T00:00:00Z",
                  "checkout_url": "https://store-one.example.com/cart/44352913:1"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The code and the permalink the buyer follows.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code", "permalink_url"],
                  "properties": {
                    "code": { "type": "string" },
                    "permalink_url": { "type": "string" },
                    "expires_at": { "type": "string", "format": "date-time" }
                  }
                },
                "example": {
                  "code": "PS-ABC123",
                  "permalink_url": "https://store-one.example.com/cart/44352913:1?discount=PS-ABC123",
                  "expires_at": "2026-01-03T00:00:00Z"
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/shopify/{topic}": {
      "post": {
        "operationId": "receiveShopifyWebhook",
        "summary": "Receive a Shopify webhook and record it as a LedgerEvent.",
        "description": "The authoritative record for reconciliation (R4). `orders/paid` becomes an `order_paid` LedgerEvent joined to the pixel observation on `checkout_token` (D24).",
        "parameters": [
          {
            "name": "topic",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["orders_paid", "orders_fulfilled", "refunds_create"] }
          },
          {
            "name": "X-Shopify-Hmac-Sha256",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object" },
              "example": {
                "checkout_token": "ck-0001",
                "order_id": "ord-0001",
                "total_price": 44.1,
                "discountApplications": [{ "type": "percentage", "value": 10.0 }]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The LedgerEvent that was appended.",
            "content": {
              "application/json": {
                "schema": { "$ref": "https://proxyshop.dev/schemas/protocol.schema.json#/$defs/LedgerEvent" },
                "example": {
                  "event_id": "ev-0002",
                  "ts": "2026-01-01T00:10:00Z",
                  "kind": "order_paid",
                  "store_id": "store-1",
                  "order_ref": "ord-0001",
                  "payload": {
                    "checkout_token": "ck-0001",
                    "order_id": "ord-0001",
                    "total_price": 44.1,
                    "discountApplications": [{ "type": "percentage", "value": 10.0 }]
                  }
                },
                "x-example-schema": "LedgerEvent"
              }
            }
          }
        }
      }
    },
    "/pixel/collect": {
      "post": {
        "operationId": "collectPixel",
        "summary": "Receive one client-side checkout observation from the Web Pixel.",
        "description": "Lossy and never authoritative (R4). It is joined to the webhook on `checkout_token`; the pixel spells its client id `clientId`, which is why `contracts.join_key_view()` is the only reader of these keys.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["checkout_token"],
                "properties": {
                  "checkout_token": { "type": "string" },
                  "clientId": { "type": "string" },
                  "total_price": { "type": "number" },
                  "discountApplications": { "type": "array", "items": { "type": "object" } }
                }
              },
              "example": {
                "checkout_token": "ck-0001",
                "clientId": "cid-0001",
                "total_price": 44.1,
                "discountApplications": [{ "type": "percentage", "value": 10.0 }]
              }
            }
          }
        },
        "responses": { "204": { "description": "Recorded." } }
      }
    },
    "/stores/{store_id}/envelope": {
      "get": {
        "operationId": "getEnvelope",
        "summary": "Read a store's envelope. SEALED — no exchange grant (S7).",
        "description": "Administrative. Requires the merchant admin bearer token; an unconfigured deployment refuses every caller with 503 rather than serving sealed state anonymously.",
        "security": [{ "adminBearer": [] }],
        "parameters": [
          { "name": "store_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The current envelope version.",
            "content": {
              "application/json": {
                "schema": { "$ref": "https://proxyshop.dev/schemas/protocol.schema.json#/$defs/Envelope" },
                "example": {
                  "store_id": "store-1",
                  "version": 3,
                  "floors": [{ "product_ref": "prod-1", "min_price": 30.0 }],
                  "max_discount_pct": 20.0,
                  "budget_cap": 500.0,
                  "pursue_clusters": ["cluster-serum"],
                  "standing_commitments": [
                    {
                      "key": "free_returns",
                      "value": "30 days",
                      "provenance": {
                        "source": "owner_statement",
                        "ref": "envelope:store-1:v3#commitment-2",
                        "observed_at": "2026-01-01T00:00:00Z",
                        "authority_rank": 1
                      }
                    }
                  ],
                  "activation": "shadow"
                },
                "x-example-schema": "Envelope"
              }
            }
          },
          "401": {
            "description": "No bearer token, or the wrong one.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "type": "string", "enum": ["unauthorized"] } }
                },
                "example": { "error": "unauthorized" }
              }
            }
          },
          "404": {
            "description": "No envelope has ever been written for this store.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error", "store_id"],
                  "properties": {
                    "error": { "type": "string", "enum": ["no-envelope"] },
                    "store_id": { "type": "string" }
                  }
                },
                "example": { "error": "no-envelope", "store_id": "store-1" }
              }
            }
          },
          "503": {
            "description": "The deployment configures no admin token, so the envelope routes refuse every caller.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error", "missing"],
                  "properties": {
                    "error": { "type": "string", "enum": ["admin-api-not-configured"] },
                    "missing": { "type": "array", "items": { "type": "string" } },
                    "detail": { "type": "string" }
                  }
                },
                "example": {
                  "error": "admin-api-not-configured",
                  "missing": ["MERCHANT_ADMIN_TOKEN"],
                  "detail": "the envelope routes refuse every caller until a token is configured"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "putEnvelope",
        "summary": "Replace a store's envelope, creating a new version.",
        "description": "Administrative, and NOT self-activating. The body is the merchant's *request*: `version` is ignored (it is derived from what is already on file) and `activation: \"active\"` is honoured only when the request also carries an `X-Envelope-Approval` artifact bound to the terms being stored. Without one the new version is written in `shadow` — the edit is not lost — and the call answers 403 `approval-required` naming the missing paperwork (R6/E5).",
        "security": [{ "adminBearer": [] }],
        "parameters": [
          { "name": "store_id", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "X-Envelope-Approval",
            "in": "header",
            "required": false,
            "description": "The merchant's recorded written approval of these exact terms, as a JSON object. `envelope_hash` is what binds it: a SHA-256 over the canonical rendering of the seven approved-terms fields plus `version`, so an approval lifted off a different envelope authorizes nothing. `approved_at` must carry a timezone. `note` and `document_ref` are optional; any other key is refused. Required only to move an envelope to `active`; a `shadow` write needs none.",
            "schema": {
              "type": "string",
              "contentMediaType": "application/json",
              "x-json-schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["approver", "approved_at", "envelope_hash"],
                "properties": {
                  "approver": { "type": "string", "minLength": 1 },
                  "approved_at": { "type": "string", "format": "date-time" },
                  "envelope_hash": { "type": "string", "minLength": 1 },
                  "note": { "type": "string" },
                  "document_ref": { "type": "string" }
                }
              }
            },
            "example": "{\"approver\": \"Dana Okafor\", \"approved_at\": \"2026-01-05T09:30:00Z\", \"envelope_hash\": \"sha256:1f0c...\", \"document_ref\": \"box://approvals/store-1-v4.pdf\"}"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "https://proxyshop.dev/schemas/protocol.schema.json#/$defs/Envelope" },
              "example": {
                "store_id": "store-1",
                "version": 4,
                "floors": [{ "product_ref": "prod-1", "min_price": 32.0 }],
                "max_discount_pct": 15.0,
                "budget_cap": 500.0,
                "pursue_clusters": ["cluster-serum"],
                "standing_commitments": [],
                "activation": "active"
              },
              "x-example-schema": "Envelope"
            }
          }
        },
        "responses": {
          "200": {
            "description": "The stored envelope. `activation` is `active` only when a bound approval accompanied the request.",
            "content": {
              "application/json": {
                "schema": { "$ref": "https://proxyshop.dev/schemas/protocol.schema.json#/$defs/Envelope" },
                "example": {
                  "store_id": "store-1",
                  "version": 4,
                  "floors": [{ "product_ref": "prod-1", "min_price": 32.0 }],
                  "max_discount_pct": 15.0,
                  "budget_cap": 500.0,
                  "pursue_clusters": ["cluster-serum"],
                  "standing_commitments": [],
                  "activation": "active"
                },
                "x-example-schema": "Envelope"
              }
            }
          },
          "400": {
            "description": "The body is not a readable envelope, or `X-Envelope-Approval` is present and is not a JSON object.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "unparseable-body",
                        "not-an-envelope",
                        "unreadable-approval"
                      ]
                    },
                    "detail": { "type": "string" }
                  }
                },
                "example": {
                  "error": "unreadable-approval",
                  "detail": "X-Envelope-Approval must carry a JSON object, got list"
                }
              }
            }
          },
          "401": {
            "description": "No bearer token, or the wrong one.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "type": "string", "enum": ["unauthorized"] } }
                },
                "example": { "error": "unauthorized" }
              }
            }
          },
          "403": {
            "description": "The body asked for `activation: \"active\"` and no approval artifact bound to these terms accompanied it. The new version IS on file, in `shadow`; nothing was activated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error", "store_id", "version", "activation"],
                  "properties": {
                    "error": { "type": "string", "enum": ["approval-required"] },
                    "store_id": { "type": "string" },
                    "version": { "type": "integer" },
                    "activation": { "$ref": "https://proxyshop.dev/schemas/protocol.schema.json#/$defs/EnvelopeActivation" },
                    "detail": { "type": "string" }
                  }
                },
                "example": {
                  "error": "approval-required",
                  "store_id": "store-1",
                  "version": 4,
                  "activation": "shadow",
                  "detail": "no written approval artifact was recorded; an envelope is never activated on anybody's say-so alone (R6)"
                }
              }
            }
          },
          "409": {
            "description": "The body names another store, or a version already superseded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": { "type": "string", "enum": ["wrong-store", "version-went-backwards"] },
                    "detail": { "type": "string" }
                  }
                },
                "example": { "error": "wrong-store", "detail": "envelope names store-2" }
              }
            }
          },
          "413": {
            "description": "The request body exceeded the 1 MiB cap and was abandoned mid-stream.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "type": "string", "enum": ["body-too-large"] } }
                },
                "example": { "error": "body-too-large" }
              }
            }
          },
          "503": {
            "description": "The deployment configures no admin token, so the envelope routes refuse every caller.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error", "missing"],
                  "properties": {
                    "error": { "type": "string", "enum": ["admin-api-not-configured"] },
                    "missing": { "type": "array", "items": { "type": "string" } },
                    "detail": { "type": "string" }
                  }
                },
                "example": {
                  "error": "admin-api-not-configured",
                  "missing": ["MERCHANT_ADMIN_TOKEN"],
                  "detail": "the envelope routes refuse every caller until a token is configured"
                }
              }
            }
          }
        }
      }
    },
    "/stores/{store_id}/kill": {
      "post": {
        "operationId": "killStoreAgent",
        "summary": "Kill switch: move the envelope to `killed` immediately.",
        "description": "Administrative. Needs no approval artifact — stopping is always allowed; only starting requires paperwork.",
        "security": [{ "adminBearer": [] }],
        "parameters": [
          { "name": "store_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The activation state after the kill.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["store_id", "activation"],
                  "properties": {
                    "store_id": { "type": "string" },
                    "activation": { "$ref": "https://proxyshop.dev/schemas/protocol.schema.json#/$defs/EnvelopeActivation" }
                  }
                },
                "example": { "store_id": "store-1", "activation": "killed" }
              }
            }
          },
          "401": {
            "description": "No bearer token, or the wrong one.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "type": "string", "enum": ["unauthorized"] } }
                },
                "example": { "error": "unauthorized" }
              }
            }
          },
          "404": {
            "description": "No envelope has ever been written for this store, so there is nothing to kill.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error", "store_id"],
                  "properties": {
                    "error": { "type": "string", "enum": ["no-envelope"] },
                    "store_id": { "type": "string" }
                  }
                },
                "example": { "error": "no-envelope", "store_id": "store-1" }
              }
            }
          },
          "409": {
            "description": "The kill was refused by the envelope store.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": { "type": "string", "enum": ["kill-refused"] },
                    "detail": { "type": "string" }
                  }
                },
                "example": { "error": "kill-refused", "detail": "the envelope is already killed" }
              }
            }
          },
          "503": {
            "description": "The deployment configures no admin token, so the envelope routes refuse every caller.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error", "missing"],
                  "properties": {
                    "error": { "type": "string", "enum": ["admin-api-not-configured"] },
                    "missing": { "type": "array", "items": { "type": "string" } },
                    "detail": { "type": "string" }
                  }
                },
                "example": {
                  "error": "admin-api-not-configured",
                  "missing": ["MERCHANT_ADMIN_TOKEN"],
                  "detail": "the envelope routes refuse every caller until a token is configured"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The merchant admin token, configured as `MERCHANT_ADMIN_TOKEN`. The envelope routes are SEALED state (C3/S7) and refuse every caller — with 503, not 200 — until it is set."
      }
    }
  }
}
