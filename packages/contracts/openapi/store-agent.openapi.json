{
  "openapi": "3.1.0",
  "info": {
    "title": "ProxyShop store-agent runner",
    "version": "1.0.0",
    "description": "SOLICITATION ONLY: exchange → seller. This is not the inbound door. An external seller submits a bid to the exchange's POST /v1/auctions/{auction_id}/bids instead, and only that route carries a SigningEnvelope. Hosted Tier-1 and external Tier-2 agents answer the same shape here."
  },
  "x-domain": "store-agent",
  "paths": {
    "/v1/bid-requests": {
      "post": {
        "operationId": "answerBidRequest",
        "summary": "Answer a solicitation with a Bid or a Decline.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "https://proxyshop.dev/schemas/protocol.schema.json#/$defs/BidRequest" },
              "example": {
                "auction_id": "auc-0001",
                "intent": {
                  "intent_id": "int-0001",
                  "cluster_id": "cluster-serum",
                  "query": "gentle vitamin C serum for sensitive skin",
                  "category": "skincare",
                  "hard_constraints": [{ "field": "fragrance_free", "op": "eq", "value": true }],
                  "preferences": [{ "field": "price", "direction": "minimize", "weight": 0.6 }],
                  "ship_to": "US-CA",
                  "currency": "USD",
                  "budget_band": "40-80",
                  "created_at": "2026-01-01T00:00:00Z",
                  "schema_version": "2.0.0"
                },
                "product_ref": "sku-serum-15",
                "profile": {
                  "pseudonym": "psn-0001",
                  "buckets": {
                    "budget_band": "40-80",
                    "category_affinity": ["skincare"],
                    "frequency_tier": "occasional",
                    "region": "US-CA",
                    "first_time": false
                  }
                },
                "respond_by": "2026-01-01T00:00:30Z"
              },
              "x-example-schema": "BidRequest"
            }
          }
        },
        "responses": {
          "200": {
            "description": "A Bid. Every claim carries hook provenance — a hosted agent cannot mint any other kind.",
            "content": {
              "application/json": {
                "schema": { "$ref": "https://proxyshop.dev/schemas/protocol.schema.json#/$defs/Bid" },
                "example": {
                  "auction_id": "auc-0001",
                  "store_id": "store-1",
                  "offer": {
                    "product_ref": "prod-1",
                    "variant_ref": "44352913",
                    "unit_price": 49.0,
                    "currency": "USD",
                    "discount": {
                      "type": "percentage",
                      "value": 10.0,
                      "provenance": {
                        "source": "envelope_rule",
                        "ref": "envelope:store-1:v3#max_discount_pct",
                        "observed_at": "2026-01-01T00:00:00Z",
                        "authority_rank": 1
                      }
                    },
                    "commitments": [],
                    "total_price": 44.1,
                    "expires_at": "2026-01-03T00:00:00Z",
                    "checkout_url": "https://store-one.example.com/cart/44352913:1"
                  },
                  "claims": [
                    {
                      "key": "free_returns",
                      "value": "30 days",
                      "provenance": {
                        "source": "owner_statement",
                        "ref": "envelope:store-1:v3#commitment-2",
                        "observed_at": "2026-01-01T00:00:00Z",
                        "authority_rank": 1
                      }
                    }
                  ],
                  "message": null,
                  "agent_version": "store-agent/1.0.0",
                  "signature": null,
                  "schema_version": "2.0.0"
                },
                "x-example-schema": "Bid"
              }
            }
          },
          "204": {
            "description": "Decline. A silent or Tier-0 store is represented by a synthesized list-price fallback upstream, not by an empty bid here."
          }
        }
      }
    },
    "/v1/trust-events": {
      "post": {
        "operationId": "ingestTrustEvent",
        "summary": "Take one pushed trust delta into this store's posture.",
        "description": "TRUST \u2192 SELLER, and to the affected seller ONLY (R13). The trust service recomputes this store's posture with and without one ledger event, and pushes the difference here; a broadcast would leak one store's trust movement to its competitors, so an agent answers 409 to an event naming any store but its own. Unsigned, for the same reason POST /v1/bid-requests is: this is the platform addressing a hosted agent by URL, not an external seller crossing the trust boundary.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "https://proxyshop.dev/schemas/protocol.schema.json#/$defs/TrustEventPayload" },
              "example": {
                "store_id": "store-1",
                "event": {
                  "event_id": "ev-0007",
                  "ts": "2026-01-01T00:00:00Z",
                  "kind": "feedback",
                  "store_id": "store-1",
                  "order_ref": "ord-0001",
                  "payload": {
                    "dim": "feedback_match",
                    "type": "contradicted",
                    "observed_at": "2026-01-01T00:00:00Z",
                    "trust_report": {
                      "schema_version": "trust-event-1.0.0",
                      "reason_code": "contradicted",
                      "identity_disclosed": false,
                      "redacted_fields": 0,
                      "policy": "R13/R5: the affected store learns what moved and never who moved it."
                    }
                  }
                },
                "dim": "feedback_match",
                "delta": -0.1666666666666667,
                "pseudonymous_context": { "cluster_id": "cluster-serum", "pseudonym": "psn-0001" }
              },
              "x-example-schema": "TrustEventPayload"
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ingested. The body is this agent's posture AFTER the event \u2014 an empty 200 would make an ingested event indistinguishable from a discarded one to the only caller that can see this door.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["store_id", "dim", "delta", "event_id", "posture"],
                  "properties": {
                    "store_id": { "type": "string", "minLength": 1 },
                    "dim": { "$ref": "https://proxyshop.dev/schemas/protocol.schema.json#/$defs/TrustDimension" },
                    "delta": { "type": "number" },
                    "event_id": { "type": "string", "minLength": 1 },
                    "posture": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["stance", "signals"],
                      "properties": {
                        "stance": { "type": "string", "enum": ["guarded", "reinforced", "neutral"] },
                        "signals": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["dim", "net_delta", "observations"],
                            "properties": {
                              "dim": { "$ref": "https://proxyshop.dev/schemas/protocol.schema.json#/$defs/TrustDimension" },
                              "net_delta": { "type": "number" },
                              "observations": { "type": "integer", "minimum": 0 }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "store_id": "store-1",
                  "dim": "feedback_match",
                  "delta": -0.1666666666666667,
                  "event_id": "ev-0007",
                  "posture": {
                    "stance": "guarded",
                    "signals": [{ "dim": "feedback_match", "net_delta": -0.1666666666666667, "observations": 1 }]
                  }
                }
              }
            }
          },
          "409": {
            "description": "The event names a store this agent does not advocate for. Sealed state is per store; absorbing a neighbour's feedback would corrupt the posture of both and nothing downstream could detect it."
          },
          "422": {
            "description": "The body is not a readable TrustEventPayload, or its delta is not a finite number (one NaN blinds a dimension permanently)."
          },
          "503": {
            "description": "This process was never given a store context, so it advocates for no store and has no posture to move."
          }
        }
      }
    }
  }
}
