{
  "openapi": "3.1.0",
  "info": {
    "title": "ProxyShop ingest service",
    "version": "1.0.0",
    "description": "Catalog refresh. Every material fact it writes is SUPPORTED_BY a Source node, and Source ≡ Provenance: the graph's `source_class` carries the same closed enum this package pins, so a fact's evidence survives the trip from a crawl into a bid."
  },
  "x-domain": "ingest",
  "paths": {
    "/er/config": {
      "get": {
        "operationId": "readEntityResolutionConfig",
        "summary": "The published resolution policy, so a caller need not hard-code the threshold.",
        "responses": {
          "200": {
            "description": "Every weight, ceiling and cap the resolver applies.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "default_threshold",
                    "max_resolve_records"
                  ],
                  "properties": {
                    "default_threshold": {
                      "type": "number"
                    },
                    "name_weight": {
                      "type": "number"
                    },
                    "corroboration_weight": {
                      "type": "number"
                    },
                    "token_weight": {
                      "type": "number"
                    },
                    "brand_conflict_ceiling": {
                      "type": "number"
                    },
                    "max_similarity_confidence": {
                      "type": "number"
                    },
                    "max_block_size": {
                      "type": "integer"
                    },
                    "min_block_token_length": {
                      "type": "integer"
                    },
                    "max_resolve_records": {
                      "type": "integer"
                    }
                  }
                },
                "example": {
                  "default_threshold": 0.86,
                  "name_weight": 0.6,
                  "corroboration_weight": 0.4,
                  "token_weight": 0.6,
                  "brand_conflict_ceiling": 0.5,
                  "max_similarity_confidence": 0.99,
                  "max_block_size": 200,
                  "min_block_token_length": 3,
                  "max_resolve_records": 500
                }
              }
            }
          }
        }
      }
    },
    "/er/match": {
      "post": {
        "operationId": "matchCatalogPair",
        "summary": "Score one pair of catalog records against each other.",
        "description": "The evidence is in the response on purpose: a resolver that answers `linked: false` and nothing else cannot be argued with.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "left": {
                    "additionalProperties": true,
                    "type": "object",
                    "title": "Left",
                    "description": "A record: product_id, gtin, canonical_name, brand."
                  },
                  "right": {
                    "additionalProperties": true,
                    "type": "object",
                    "title": "Right",
                    "description": "The other record, same shape."
                  },
                  "threshold": {
                    "type": "number",
                    "maximum": 1.0,
                    "exclusiveMinimum": 0.0,
                    "title": "Threshold",
                    "description": "The SAME_AS floor. 0.0 would link everything and is refused.",
                    "default": 0.86
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "left",
                  "right"
                ],
                "title": "MatchRequest",
                "description": "Two catalog records to score against each other."
              },
              "example": {
                "left": {
                  "product_id": "p1",
                  "gtin": "0012345678905",
                  "canonical_name": "Blue Widget",
                  "brand": "Acme"
                },
                "right": {
                  "product_id": "p2",
                  "gtin": "12345678905",
                  "canonical_name": "Blue Widget",
                  "brand": "Acme"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The decision, the evidence behind its confidence, and the GTIN each side reduced to.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "linked",
                    "confidence",
                    "method",
                    "threshold",
                    "pair"
                  ],
                  "properties": {
                    "linked": {
                      "type": "boolean"
                    },
                    "confidence": {
                      "type": "number"
                    },
                    "method": {
                      "type": "string"
                    },
                    "threshold": {
                      "type": "number"
                    },
                    "pair": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "evidence": {
                      "type": "object"
                    },
                    "normalized_gtin": {
                      "type": "object",
                      "properties": {
                        "left": {
                          "type": "string"
                        },
                        "right": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "linked": true,
                  "confidence": 0.99,
                  "method": "similarity",
                  "threshold": 0.86,
                  "pair": [
                    "p1",
                    "p2"
                  ],
                  "evidence": {
                    "brand": 1.0,
                    "name": 1.0
                  },
                  "normalized_gtin": {
                    "left": "00012345678905",
                    "right": ""
                  }
                }
              }
            }
          }
        }
      }
    },
    "/er/resolve": {
      "post": {
        "operationId": "resolveCatalogRecords",
        "summary": "Block, score and return the SAME_AS edges a batch of records justifies.",
        "description": "`dropped_blocks` is in the response because a pass that skipped an over-large block found less than it could have, and a caller that cannot see that cannot tell it from a catalog with no duplicates.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "records": {
                    "items": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "type": "array",
                    "maxItems": 500,
                    "title": "Records"
                  },
                  "threshold": {
                    "type": "number",
                    "maximum": 1.0,
                    "exclusiveMinimum": 0.0,
                    "title": "Threshold",
                    "default": 0.86
                  },
                  "max_block_size": {
                    "type": "integer",
                    "maximum": 10000.0,
                    "minimum": 2.0,
                    "title": "Max Block Size",
                    "default": 200
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "records"
                ],
                "title": "ResolveRequest",
                "description": "A catalog slice to resolve into SAME_AS edges."
              },
              "example": {
                "records": [
                  {
                    "product_id": "p1",
                    "gtin": "0012345678905",
                    "canonical_name": "Blue Widget",
                    "brand": "Acme"
                  },
                  {
                    "product_id": "p2",
                    "gtin": "12345678905",
                    "canonical_name": "Blue Widget",
                    "brand": "Acme"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The SAME_AS edges, how many comparisons paid for them, and what was skipped.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "threshold",
                    "records",
                    "compared",
                    "edges"
                  ],
                  "properties": {
                    "threshold": {
                      "type": "number"
                    },
                    "records": {
                      "type": "integer"
                    },
                    "compared": {
                      "type": "integer"
                    },
                    "dropped_blocks": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "edges": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "left_id": {
                            "type": "string"
                          },
                          "right_id": {
                            "type": "string"
                          },
                          "confidence": {
                            "type": "number"
                          },
                          "method": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "threshold": 0.86,
                  "records": 2,
                  "compared": 1,
                  "dropped_blocks": [],
                  "edges": [
                    {
                      "left_id": "p1",
                      "right_id": "p2",
                      "confidence": 0.99,
                      "method": "similarity"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/extraction/config": {
      "get": {
        "operationId": "readExtractionConfig",
        "summary": "The published extraction policy, so a caller need not hard-code the floor.",
        "description": "A constant. It deliberately no longer carries the ledger's occupancy, which on an unauthenticated route was a free progress oracle (T-367).",
        "responses": {
          "200": {
            "description": "The confidence floor, the extractor's version, the claim vocabulary and every request ceiling.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "confidence_floor",
                    "extractor_version",
                    "claim_types"
                  ],
                  "properties": {
                    "confidence_floor": {
                      "type": "number"
                    },
                    "extractor_version": {
                      "type": "string"
                    },
                    "claim_types": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "max_url_chars": {
                      "type": "integer"
                    },
                    "max_body_chars": {
                      "type": "integer"
                    },
                    "max_kind_chars": {
                      "type": "integer"
                    },
                    "max_known_hash_chars": {
                      "type": "integer"
                    },
                    "max_observed_at_chars": {
                      "type": "integer"
                    }
                  }
                },
                "example": {
                  "confidence_floor": 0.6,
                  "extractor_version": "policy_extraction@1.0.0",
                  "claim_types": [
                    "compatibility",
                    "delivery",
                    "discount",
                    "dispatch_window",
                    "ingredients",
                    "nutrition",
                    "price",
                    "promo_eligibility",
                    "return_policy",
                    "shipping_speed",
                    "specifications",
                    "total_price",
                    "unit_price",
                    "warranty"
                  ],
                  "max_url_chars": 2048,
                  "max_body_chars": 4194304,
                  "max_kind_chars": 64,
                  "max_known_hash_chars": 128,
                  "max_observed_at_chars": 64
                }
              }
            }
          }
        }
      }
    },
    "/extraction/policy-pages": {
      "post": {
        "operationId": "extractPolicyPage",
        "summary": "Extract claims from a policy page body the caller supplies.",
        "description": "Unauthenticated and bounded: every string field carries its ceiling, and `known_hash` lets an unchanged page re-extract nothing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "title": "Url",
                    "description": "The page's URL; provenance points at it.",
                    "max_chars": 2048
                  },
                  "body": {
                    "type": "string",
                    "title": "Body",
                    "description": "The page as fetched. HTML or plain text.",
                    "max_chars": 4194304
                  },
                  "kind": {
                    "type": "string",
                    "title": "Kind",
                    "description": "PolicyPage.kind; derived from the URL when absent.",
                    "default": "",
                    "max_chars": 64
                  },
                  "known_hash": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Known Hash",
                    "description": "The digest recorded last time. An unchanged page re-extracts nothing.",
                    "max_chars": 128
                  },
                  "observed_at": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Observed At",
                    "description": "When the page was read, as an ISO-8601 instant. Retained on the page-level provenance and on every claim's, so it is both length-capped and parsed.",
                    "max_chars": 64
                  },
                  "confidence_floor": {
                    "type": "number",
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Confidence Floor",
                    "default": 0.6
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "url",
                  "body"
                ],
                "title": "ExtractRequest",
                "description": "One page handed to the extractor directly.\n\nEvery string below carries its ceiling on the field. That is enforced, not a convention:\n:class:`BoundedTextRequest` refuses to define a subclass that leaves one off."
              },
              "example": {
                "url": "https://shop.example.com/policies/returns",
                "body": "Free returns within 30 days. Ships in 2 business days.",
                "kind": "returns"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The claims the page justified, each with the provenance that points back at it, plus anything quarantined.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "content_hash",
                    "snapshot_ref",
                    "claims"
                  ],
                  "properties": {
                    "content_hash": {
                      "type": "string"
                    },
                    "snapshot_ref": {
                      "type": "string"
                    },
                    "confidence_floor": {
                      "type": "number"
                    },
                    "extractor": {
                      "type": "string"
                    },
                    "extractor_version": {
                      "type": "string"
                    },
                    "model_calls": {
                      "type": "integer"
                    },
                    "reused": {
                      "type": "boolean"
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "claims": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "quarantined": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                },
                "example": {
                  "content_hash": "sha256:e41603b3875d19df1b7a7485b0c59c2bcafd09853f768a4a21792dd6e5c51395",
                  "snapshot_ref": "snapshot://shop.example.com/policies/returns@sha256:e41603b3875d19df1b7a7485b0c59c2bcafd09853f768a4a21792dd6e5c51395",
                  "confidence_floor": 0.6,
                  "extractor": "rules",
                  "extractor_version": "policy_extraction@1.0.0",
                  "model_calls": 0,
                  "reused": false,
                  "warnings": [],
                  "claims": [
                    {
                      "key": "returns.window_days",
                      "value": 30,
                      "unit": "days",
                      "claim_type": "return_policy",
                      "confidence": 0.93,
                      "evidence": "Free returns within 30 days.",
                      "span": [
                        5,
                        27
                      ],
                      "quarantine_reason": "",
                      "provenance": {
                        "source": "scraped",
                        "ref": "snapshot://shop.example.com/policies/returns@sha256:e41603b3875d19df1b7a7485b0c59c2bcafd09853f768a4a21792dd6e5c51395",
                        "observed_at": "2026-01-01T00:20:00Z"
                      }
                    }
                  ],
                  "quarantined": []
                }
              }
            }
          }
        }
      }
    },
    "/schedule": {
      "get": {
        "operationId": "readIngestSchedule",
        "summary": "What the scheduler will do next, per store and per field.",
        "description": "The operator-facing answer to 'is the graph current, and if not, when will it be?'. Every number comes from the persisted schedule, so it doubles as the readback proving the durable state survives a restart.",
        "responses": {
          "200": {
            "description": "The scheduler's clock, its cadence table, and the plan for every registered store.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "now",
                    "durable",
                    "cadence",
                    "stores"
                  ],
                  "properties": {
                    "now": {
                      "type": "string",
                      "description": "The scheduler's own clock, ISO-8601."
                    },
                    "durable": {
                      "type": "boolean",
                      "description": "false when the schedule lives only in this process."
                    },
                    "state": {
                      "type": "string",
                      "description": "The schedule store, named."
                    },
                    "cadence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "field",
                          "section",
                          "max_age_seconds"
                        ],
                        "properties": {
                          "field": {
                            "type": "string"
                          },
                          "section": {
                            "type": "string"
                          },
                          "max_age_seconds": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "stores": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                },
                "example": {
                  "now": "2026-09-07T00:07:44.385981+00:00",
                  "durable": false,
                  "state": "MemoryScheduleStore(durable=False)",
                  "cadence": [
                    {
                      "field": "offer.price",
                      "section": "products",
                      "max_age_seconds": 3600
                    },
                    {
                      "field": "policy.claims",
                      "section": "policies",
                      "max_age_seconds": 604800
                    }
                  ],
                  "stores": []
                }
              }
            }
          }
        }
      }
    },
    "/schedule/tick": {
      "post": {
        "operationId": "runIngestScheduleTick",
        "summary": "Run one refresh cycle: every store that has aged out, through only the adapters it needs.",
        "description": "The scheduler's whole driving surface — a cron entry, a CronJob, or an operator's curl. Idempotent in the way that matters: the decision is recomputed from the persisted per-field timestamps every time. Answers 200 rather than 202 because the work is finished when the response is written.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "properties": {
                      "force": {
                        "type": "boolean",
                        "title": "Force",
                        "description": "Treat every field as overdue, so every registered store is refreshed. This overrides the cadence clock only: the differential hash ledger is untouched, so a forced tick of an unchanged store still performs no graph work.",
                        "default": false
                      }
                    },
                    "additionalProperties": false,
                    "type": "object",
                    "title": "TickRequest",
                    "description": "The body of ``POST /schedule/tick``."
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Payload"
              },
              "example": {
                "force": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "What the tick did: the stores it refreshed, the ones it left alone, and the ones that failed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "at",
                    "ran",
                    "skipped",
                    "failed"
                  ],
                  "properties": {
                    "at": {
                      "type": "string"
                    },
                    "ran": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "skipped": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "failed": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                },
                "example": {
                  "at": "2026-09-07T00:07:44.387816+00:00",
                  "ran": [],
                  "skipped": [],
                  "failed": []
                }
              }
            }
          }
        }
      }
    },
    "/extraction/stores/{store_id}": {
      "post": {
        "operationId": "crawlStorePolicyPages",
        "summary": "Crawl a storefront's policy pages through the netguard and extract them.",
        "parameters": [
          {
            "name": "store_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "store_id": {
                    "type": "string",
                    "minLength": 1,
                    "title": "Store Id",
                    "max_chars": 128
                  },
                  "base_url": {
                    "type": "string",
                    "minLength": 1,
                    "title": "Base Url",
                    "max_chars": 2048
                  },
                  "allowed_hosts": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array",
                    "title": "Allowed Hosts",
                    "max_chars": 253,
                    "max_items": 64
                  },
                  "confidence_floor": {
                    "type": "number",
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Confidence Floor",
                    "default": 0.6
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "store_id",
                  "base_url"
                ],
                "title": "StoreCrawlRequest",
                "description": "A storefront whose policy pages should be fetched and extracted."
              },
              "example": {
                "store_id": "store-1",
                "base_url": "https://shop.example.com",
                "allowed_hosts": [
                  "shop.example.com"
                ],
                "confidence_floor": 0.6
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "What the crawl reached, what it extracted, and every page it refused.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "store_id",
                    "base_url",
                    "observed_at",
                    "pages",
                    "warnings"
                  ],
                  "properties": {
                    "store_id": {
                      "type": "string"
                    },
                    "base_url": {
                      "type": "string"
                    },
                    "observed_at": {
                      "type": "string",
                      "description": "RFC-3339; the instant every claim's provenance points at."
                    },
                    "model_calls": {
                      "type": "integer"
                    },
                    "reused": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Pages whose digest was unchanged, so nothing was re-extracted."
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Every page robots.txt or the netguard refused, named."
                    },
                    "hash_index": {
                      "type": "object",
                      "description": "url -> content digest, for the caller's next known_hash."
                    },
                    "upserts": {
                      "type": "integer"
                    },
                    "pages": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "One extraction result per fetched page, with that page's url, kind, page_id and changed flag folded in."
                    }
                  }
                },
                "example": {
                  "store_id": "store-1",
                  "base_url": "https://shop.example.com",
                  "observed_at": "2026-09-07T00:04:50Z",
                  "model_calls": 0,
                  "reused": [],
                  "warnings": [
                    "robots.txt unreachable (refused 'https://shop.example.com/robots.txt': unresolvable); treating the store as disallow-all",
                    "robots.txt disallows https://shop.example.com/policies/refund-policy"
                  ],
                  "hash_index": {},
                  "upserts": 0,
                  "pages": []
                }
              }
            }
          }
        }
      }
    },
    "/refresh/{store_id}": {
      "post": {
        "operationId": "refreshStoreCatalog",
        "summary": "Re-crawl and re-extract one store's catalog and policy pages.",
        "parameters": [
          { "name": "store_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "force": { "type": "boolean", "default": false },
                  "sections": { "type": "array", "items": { "type": "string" } }
                }
              },
              "example": { "force": false, "sections": ["products", "policies"] }
            }
          }
        },
        "responses": {
          "202": {
