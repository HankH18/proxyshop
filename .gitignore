**/.react-router/
.eslintcache
.turbo/

# Secrets / local env
.env
.env.*
!.env.example

# Tooling indexes
.codegraph/

# Swarm-loop: state + goals ARE committed; these are not
.swarm-loop/worktrees/
.swarm-loop/archive/
.swarm-loop/tmp/

# Local agent settings (permissions/hooks) stay local
.claude/settings.local.json

# Docker volumes
.docker-data/
.claude/.claude-build.json
*.py[co]
