# OS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/
# hypothesis writes per-worker example DBs into the rootdir
.hypothesis/

# Node
node_modules/
.next/
dist/
build/
*.tsbuildinfo
.vitest/
# vitest/istanbul output dir (the Python `.coverage` file is above)
coverage/
# react-router v7 typegen; eslint + vitest already treat it as generated
**/.react-router/
.eslintcache
.turbo/

# Secrets / local env
.env
.env.*
!.env.example

# Tooling indexes
.codegraph/

# Swarm-loop: state + goals ARE committed; these are not
.swarm-loop/worktrees/
.swarm-loop/archive/
.swarm-loop/tmp/

# Local agent settings (permissions/hooks) stay local
.claude/settings.local.json

# Docker volumes
.docker-data/
.claude/.claude-build.json

# build_succeeds' evidence log (goals.json amendment 3): rewritten every
# measurement, and a tracked copy would churn main each cycle and put a
# .swarm-loop/ path in any branch diff that produced it (check-branch vetoes those).
#
# A GLOB, because the rule used to be the exact path `.swarm-loop/reports/verify-last.log`
# and an exact path only ignores the file that never moves. Two run logs were committed past
# it anyway — `.swarm-loop/reports/stale/verify-last.log` and `.../stale/verify-last.1.log`,
# a moved copy and a rotated one — and both were outside a rule with no wildcard in it.
# `**/` matches zero or more directories, so this covers the live path and any sub-directory
# a future rotation invents.
.swarm-loop/reports/**/*.log

# T-210 probe scratch trees (see the ruff extend-exclude note); ephemeral, never committed
.t210-*
*.py[co]
